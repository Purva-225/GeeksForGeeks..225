class Solution {
  public:
    int median(vector<vector<int>> &mat) {
        int rows = mat.size();
        int cols = mat[0].size();
        
         int required = ((rows*cols)/2) + 1;
        
         int low = mat[0][0];
         int high = mat[0][cols-1];
         
         for(int i = 1; i<rows; i++){
           low = min(low, mat[i][0]);
           high = max(high,mat[i][cols-1]);
         }
         while(low<=high){
             int mid = low + (high - low)/2;
             
             int Cnt = 0; 
             
             for(int i = 0; i<rows; i++){
               Cnt += upper_bound(mat[i].begin(),mat[i].end(),mid)-
                 mat[i].begin();
             }
             if(Cnt < required){
                 low = mid+1; 
             }else{
                 high = mid-1; 
             }
         }
         return low; 
    }
};
